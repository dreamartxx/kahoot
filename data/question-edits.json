{
  "dinozor-0afc4b35d0a856": {
    "text": "Triceratops’un dişleri en çok hangi besini parçalamaya uygundu?",
    "options": [
      "Balık pulları",
      "Yumuşakça kabukları",
      "Lifli bitkiler",
      "İri kemikler"
    ],
    "correct": 2,
    "explanation": "Doğru cevap: Lifli bitkiler."
  },
  "dinozor-4485bf1bf26f52": {
    "text": "Stegosaurus’un sırt levhaları neden kazılarda bazen iskeletten ayrı bulunur?",
    "options": [
      "Omurgaya kaynaşmayıp deriye gömülü oldukları için",
      "Yalnızca yavrularda bulundukları için",
      "Kemik yerine boynuzdan oluştukları için",
      "Hayvan her yıl bütün levhalarını attığı için"
    ],
    "correct": 0,
    "explanation": "Levhalar derinin içinde gelişiyordu. Hayvan öldüğünde omurgadan ayrılabiliyorlardı.",
    "source": "https://www.nhm.ac.uk/discover/dino-directory/stegosaurus.html"
  },
  "dinozor-c510b6b668058a": {
    "text": "Uzun boyunlu Brachiosaurus ile Triceratops’un ortak özelliği hangisidir?",
    "options": [
      "Kuyruklarında kemik topuz bulunması",
      "Ön ayaklarında iki parmak bulunması",
      "Bitkilerle beslenmeleri",
      "Başlarında üç boynuz bulunması"
    ],
    "correct": 2,
    "explanation": "Doğru cevap: Bitkilerle beslenmeleri."
  },
  "dinozor-0f865f2d63e42d": {
    "text": "Velociraptor’un kıvrık pençeleri hangi beslenme biçimiyle uyumludur?",
    "options": [
      "Otları öğüterek beslenmek",
      "Yüksek dallardan yaprak toplamak",
      "Avını yakalayıp etle beslenmek",
      "Sudaki planktonları süzmek"
    ],
    "correct": 2,
    "explanation": "Doğru cevap: Avını yakalayıp etle beslenmek."
  },
  "dinozor-edce9ee703a1a9": {
    "text": "Hangi otçul dinozor, yırtıcılara karşı kuyruğunun ucundaki kemik topuzu kullanabilirdi?",
    "options": [
      "Ankylosaurus",
      "Triceratops",
      "Diplodocus",
      "Brachiosaurus"
    ],
    "correct": 0,
    "explanation": "Doğru cevap: Ankylosaurus."
  },
  "dinozor-9e521aaae3e051": {
    "text": "Uzun ve dar çenesiyle balık da avlayan dinozor hangisidir?",
    "options": [
      "Triceratops",
      "Stegosaurus",
      "Diplodocus",
      "Spinosaurus"
    ],
    "correct": 3,
    "explanation": "Doğru cevap: Spinosaurus.",
    "source": "https://www.nhm.ac.uk/discover/dino-directory/spinosaurus.html"
  },
  "dinozor-3b170199b0163d": {
    "text": "Bir dinozorun fosilleşmiş kemiklerini incelemek hangi bilim dalının alanına girer?",
    "options": [
      "Arkeoloji",
      "Antropoloji",
      "Paleontoloji",
      "Mineraloji"
    ],
    "correct": 2,
    "explanation": "Doğru cevap: Paleontoloji."
  },
  "dinozor-c31cf8b5b4e76f": {
    "text": "Bir müzede sauropod iskeletini hangi özelliğinden tanıyabilirsin?",
    "options": [
      "Boyun yakası ve yüzündeki üç boynuzdan",
      "Kafasının üzerindeki kemiksi kubbeden",
      "Sırtındaki iki sıra büyük levhadan",
      "Uzun boynu ve sütun gibi dört bacağından"
    ],
    "correct": 3,
    "explanation": "Doğru cevap: Uzun boynu ve sütun gibi dört bacağından."
  },
  "dinozor-7877b193e2d352": {
    "text": "Dinozorların nasıl çoğaldığını gösteren en doğrudan bulgu hangisidir?",
    "options": [
      "Bir arada bulunan farklı boyda ayak izleri",
      "İçinde embriyo korunmuş fosil yumurta",
      "Aynı katmanda bulunan yetişkin iskeletleri",
      "Bir yuvanın yakınındaki bitki kalıntıları"
    ],
    "correct": 1,
    "explanation": "Doğru cevap: İçinde embriyo korunmuş fosil yumurta."
  },
  "dinozor-6979c92a264903": {
    "text": "Bir dinozorun bitki mi et mi yediğini araştırırken hangi kemiğe öncelik verirsin?",
    "options": [
      "Kalça kemiği",
      "Kuyruk omuru",
      "Dişleri korunmuş çene",
      "Kürek kemiği"
    ],
    "correct": 2,
    "explanation": "Doğru cevap: Dişleri korunmuş çene."
  },
  "dinozor-55b52daca78e38": {
    "text": "Bir yırtıcıya karşı kuyruğundaki uzun sivri dikenlerden yararlanabilen dinozor hangisidir?",
    "options": [
      "Stegosaurus",
      "Brachiosaurus",
      "Triceratops",
      "Tyrannosaurus rex"
    ],
    "correct": 0,
    "explanation": "Doğru cevap: Stegosaurus."
  },
  "dinozor-cd6df888a1c8ba": {
    "text": "Plesiosaurların suda hareket etmesini sağlayan belirgin özellik hangisidir?",
    "options": [
      "Yelpaze biçiminde iki kanat",
      "Perdeli iki arka ayak",
      "Kürek biçiminde dört uzuv",
      "Uzun ve eklemli parmaklar"
    ],
    "correct": 2,
    "explanation": "Doğru cevap: Kürek biçiminde dört uzuv."
  },
  "dinozor-fb84b4fa9c0d03": {
    "text": "Mosasaurus, balinalara dış görünüşüyle benzese de hangi gruba aittir?",
    "options": [
      "Kıkırdaklı balıklar",
      "Deniz memelileri",
      "Amfibiler",
      "Deniz sürüngenleri"
    ],
    "correct": 3,
    "explanation": "Doğru cevap: Deniz sürüngenleri."
  },
  "dinozor-489bd398f6e6fa": {
    "text": "Bir fosilin gömüldüğü dönemi belirlemek için hangi bilgiyi kaydetmek özellikle önemlidir?",
    "options": [
      "Kemiğin yüzey rengi",
      "İskeletin toplam boyu",
      "Bulunduğu kaya katmanı",
      "Kafatasındaki diş sayısı"
    ],
    "correct": 2,
    "explanation": "Doğru cevap: Bulunduğu kaya katmanı."
  },
  "dinozor-e8ed8a874b78fb": {
    "text": "Tek bir ayak izinden farklı olarak art arda korunmuş izler hangi bilgiyi verir?",
    "options": [
      "Adımlar arasındaki mesafeyi",
      "Dişlerin biçimini",
      "Yumurtaların büyüklüğünü",
      "Besinlerin türünü"
    ],
    "correct": 0,
    "explanation": "Doğru cevap: Adımlar arasındaki mesafeyi."
  },
  "dinozor-df13e18be9d448": {
    "text": "Bir fosilde hangi bulgu dinozorun dış görünüşünü çizerken doğrudan yol gösterir?",
    "options": [
      "Kazı sırasındaki hava sıcaklığı",
      "Kayanın deniz seviyesinden bugünkü yüksekliği",
      "Kemiklerin çevresinde korunmuş tüy izleri",
      "Katmandaki taşların ortalama büyüklüğü"
    ],
    "correct": 2,
    "explanation": "Doğru cevap: Kemiklerin çevresinde korunmuş tüy izleri."
  },
