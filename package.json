{
  "name": "bilgi-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:bank": "python3 scripts/build_bank.py --check && python3 scripts/build_quiz_formats.py --check",
    "build:mobile": "vite build --outDir mobile-build && node scripts/mobile-build.mjs && cap sync android",
    "android:debug": "npm run build:mobile && node scripts/android-build.mjs assembleDebug",
    "android:release": "npm run build:mobile && node scripts/android-build.mjs bundleRelease assembleRelease",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "flag-icons": "^7.5.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "prettier": "^3.9.9",
    "vite": "^7.1.0"
  }
}
